{
  "name": "@newfoundcodes/helvetium-mcp",
  "version": "0.1.2",
  "description": "A standalone TypeScript implementation of Model Context Protocol 2026-07-28 with Helvetium Boot integration.",
  "type": "module",
  "sideEffects": false,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./http": {
      "types": "./dist/transport/http.d.ts",
      "import": "./dist/transport/http.js"
    },
    "./stdio": {
      "types": "./dist/transport/stdio.d.ts",
      "import": "./dist/transport/stdio.js"
    },
    "./boot": {
      "types": "./dist/integration/boot.d.ts",
      "import": "./dist/integration/boot.js"
    },
    "./authorization": {
      "types": "./dist/authorization.d.ts",
      "import": "./dist/authorization.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js"
    },
    "./apps": {
      "types": "./dist/apps.d.ts",
      "import": "./dist/apps.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage site",
    "format": "prettier --write .",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json --noEmit",
    "examples:test": "npm run build && node examples/test-all.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "coverage": "npm run build && node --experimental-test-coverage --test tests/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run examples:typecheck && npm test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "keywords": [
    "model-context-protocol",
    "mcp",
    "ai",
    "agents",
    "helvetium",
    "helvetium-boot",
    "typescript",
    "json-rpc",
    "tools",
    "resources",
    "prompts"
  ]
}
